# Portfolio demo mode (browser-local IndexedDB, no backend required)
# Set to true on Vercel Hobby for the standalone interactive portfolio demo
VITE_DEMO_MODE=false

# Full-stack mode: set to your deployed backend URL (with or without /api)
# Example: VITE_API_BASE_URL=https://edent-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5050/api

# Local development fallback port when VITE_API_BASE_URL is omitted
VITE_PORT_SPRING=5050
